# App
APP_URL=http://localhost:3000
# Auth
# Generate with:  openssl rand -base64 48
AUTH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiro
# Set to "true" if your provider (Neon/Supabase/RDS) requires SSL
DATABASE_SSL=false

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Hiro Interview <no-reply@hiro.app>"

# Optional: where the admin copy of reports goes
ADMIN_EMAIL=admin@hiro.app

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (client-side demo - safe to leave blank)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_OPENAI_API_KEY=
