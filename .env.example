# App
APP_URL=http://localhost:3000
# Auth
# Generate with:  openssl rand -base64 48
AUTH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24

# Optional: env-based super admin bootstrap login
# If set, logging in with these credentials via /login will upsert a verified
# super admin account and redirect to /admin.
SUPER_ADMIN_EMAIL=owner@selectwise.app
SUPER_ADMIN_PASSWORD=replace_with_strong_password
SUPER_ADMIN_NAME=Selectwise Owner

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/selectwise
# Set to "true" if your provider (Neon/Supabase/RDS) requires SSL
DATABASE_SSL=false

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Selectwise <no-reply@selectwise.app>"

# Optional: where the admin copy of reports goes
ADMIN_EMAIL=admin@selectwise.app

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
# Optional fallback (if omitted server key id will be used)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Razorpay webhook signing secret (Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Google Calendar (service account)
# 1) Share your target calendar with the service account email
# 2) Put the service account private key with escaped newlines (\n)
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (client-side demo - safe to leave blank)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_OPENAI_API_KEY=
